* EG12523 engineering macro: VIN hysteresis, SS, FB/CS comparator, floating HO.
V_logic one 0 1
S_uv enable 0 n29 0 UVLO
R_enable one enable 1k
B_uvrun uv_run 0 V=1-v(enable)
C_fault fault_timer 0 1u IC=0
B_fault 0 fault_timer I=1u*(v(uv_run)>.5)*(v(n41,0)>4.9)
B_fault_reset fault_timer 0 I=v(fault_timer)*((v(uv_run)<.5)+(v(n41,0)<4.9))/100
C_fault_latch fault_latched 0 1n IC=0
B_fault_set 0 fault_latched I=(v(fault_timer)>.07)*max(0,1-v(fault_latched))/10
B_fault_clear fault_latched 0 I=(v(uv_run)<.5)*v(fault_latched)/10
R_fault_hold fault_latched 0 1e12
B_run run 0 V=v(uv_run)*(v(fault_latched)<.5)
B_vinload n29 0 I=0.00003*(1-v(run))+v(run)*0.0023
B_fbpull n41 0 I=(v(n41,0)-5*v(run))/6250
B_ss 0 n26 I=10u*v(run)*(v(n26,0)<3.5)
B_ssreset n26 0 I=(1-v(run))*v(n26,0)/10
V_clock saw 0 PULSE(0 1 0 0.00001439860465116279 10n 1n 0.000014418604651162789)
B_limit eg_threshold 0 V=max(0,min(.8,min(v(n41,0)/2.8,v(n26,0)/2.8)))
C_trip trip 0 1n IC=0
B_trip_set 0 trip I=(v(run)>.5)*.5*(1+tanh((v(saw)-0.005548387096774195)/.0002))*.5*(1+tanh((v(n22,0)-v(eg_threshold))/.001))*max(0,1-v(trip))/10
B_trip_reset trip 0 I=(.5*(1-tanh((v(saw)-0.0027741935483870973)/.0002))+(v(run)<.5))*v(trip)/10
R_trip_hold trip 0 1e12
B_pwm pwm 0 V=(v(run)>.5)*(v(saw)<.46)*(v(trip)<.5)
B_out out_internal 0 V=v(pwm)*max(0,min(17,v(n29,0)))
R_out out_internal n78 1
B_ho ho_internal n8 V=v(pwm)*(v(n31,0)>5)*max(0,min(17,v(n30,n8)))
R_ho ho_internal n44 .25
B_lo lo_internal 0 V=v(pwm)*(v(n31,0)>5)*max(0,min(17,v(n31,0)))
R_lo lo_internal n46 .25
B_vcc_load n31 0 I=1m*v(run)
